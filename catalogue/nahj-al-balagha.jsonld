      "bf:originDate": "1022 AH / 1613 CE",
      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "نسخة خطية من مخطوط نهج البلاغة، تُنسب إلى الشريف الرضي الذي جمعها وشرحها، تتميز هذه النسخة بخط جميل وواضح، وتحتوي على زخارف وهامش مذهب، وهي من أقدم النسخ المحفوظة التي تحمل هذا النص القيّم.",
            "@language": "ar"
          },
          {
            "@value": "Illuminated manuscript of Nahj al-Balagha compiled by Al-Sharif al-Radi, transcribed in 1022 AH with ornate gold borders, intricate arabesque frontispiece, and red ink chapter markings.",
            "@language": "en"
          }
        ]
      },
      "bf:hasInstance": {
        "@id": "https://isaacrow.github.io/alqami6/catalogue/nahj-al-balagha#instance"
