              "@value": "ورق مجدول ومذهب، حبر أسود، مداد أحمر، خط النسخ الأصيل",
              "@language": "ar"
            },
            {
              "@value": "Gold-ruled paper, carbon ink, cinnabar rubrication, Naskh script",
              "@language": "en"
            }
          ]
        },
        {
