              "@value": "تجليد جلدي إسلامي أصيل مزخرف بنقوش هندسية مذهبة ومحكمة",
              "@language": "ar"
            },
            {
              "@value": "Authentic Islamic leather binding with gilded geometric tooling",
              "@language": "en"
            }
          ]
        },
        {
          "@type": "bf:Note",
          "bf:noteType": "decoration",
          "rdfs:label": [
            {
              "@value": "النسخة مجدولة بالذهب، وأولها لوحة فنية مذهبة بديعة وعناوين بالمداد الأحمر",
              "@language": "ar"
            },
            {
              "@value": "Gold-illuminated borders, gilded frontispiece, and rubricated chapter headers",
