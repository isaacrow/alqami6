        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "كتاب فلسفي كلامي للميرداماد يناقش حدوث العالم وقدمه ومسألة الدهر والزمان، النسخة مجدولة ومذهبة وغلافها جلد أحمر أصيل بنظام التعقيبات التاريخية.",
            "@language": "ar"
          },
          {
            "@value": "Theological and philosophical treatise by Mir Damad discussing cosmos origination, time and eternity (Dahr), in gold-ruled margins and red leather binding.",
            "@language": "en"
          }
        ]
