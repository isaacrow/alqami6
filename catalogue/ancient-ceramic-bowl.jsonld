      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "وعاء خزفي ناصع البياض مزجج بطلاء رائق، محلى بحافة خط كوفي أندلسي يحمل حكم وأمثال في الكرم والأدب باللون البني المحروق.",
            "@language": "ar"
          },
          {
            "@value": "Elegantly proportioned white earthenware bowl painted in dark slip with floriated Kufic aphorism on generosity and good manners.",
            "@language": "en"
          }
        ]
      },
