      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "منحوتة تاريخية شامخة من حجر الديوريت الأسود، يظهر في أعلاها الملك حمورابي وهو يتلقى شريعة العدل من إله الشمس شمش، وتحتها 282 مادة قانونية بليغة.",
            "@language": "ar"
          },
          {
            "@value": "Monumental black diorite stela depicting King Hammurabi receiving laws from Shamash the sun god, inscribed with 282 legal edicts in cuneiform.",
            "@language": "en"
          }
        ]
      },
