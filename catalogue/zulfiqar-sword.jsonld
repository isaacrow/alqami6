      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "سيف تاريخي احتفالي مستوحى من طراز ذي الفقار الشهير، مصوغ من الفولاذ الدمشقي الجوهري، مع مقبض مطعم بالعاج ونصل منقوش بآيات قرآنية مطلية بالذهب الخالص.",
            "@language": "ar"
          },
          {
            "@value": "Historic ceremonial curved scimitar forged from folded Damascus crucible steel, decorated with Quranic calligraphic cartouches inlaid with 24k gold, and ivory hilt.",
            "@language": "en"
          }
        ]
      },
